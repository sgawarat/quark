{
  "$schema": "https://gitlab.kitware.com/cmake/cmake/-/raw/master/Help/manual/presets/schema.json",
  "version": 8,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_COLOR_DIAGNOSTICS": "ON"
      }
    },
    {
      "name": "gcc",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "clang",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "clang-cl",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl"
      }
    },
    {
      "name": "clang-tidy",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_C_CLANG_TIDY": "clang-tidy",
        "CMAKE_CXX_CLANG_TIDY": "clang-tidy"
      }
    },
    {
      "name": "w64-mingw32-gcc",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Windows",
        "CMAKE_SYSTEM_PROCESSOR": "x86_64",
        "CMAKE_C_COMPILER": "x86_64-w64-mingw32-gcc",
        "CMAKE_CXX_COMPILER": "x86_64-w64-mingw32-g++",
        "CMAKE_RC_COMPILER": "x86_64-w64-mingw32-windres",
        "CMAKE_FIND_ROOT_PATH": "/usr/x86_64-w64-mingw32",
        "CMAKE_FIND_ROOT_PATH_MODE_PROGRAM": "NEVER",
        "CMAKE_FIND_ROOT_PATH_MODE_LIBRARY": "ONLY",
        "CMAKE_FIND_ROOT_PATH_MODE_INCLUDE": "ONLY",
        "CMAKE_GET_RUNTIME_DEPENDENCIES_PLATFORM": "windows+pe",
        "CMAKE_TOOLCHAIN_FILE": ""
      }
    },
    {
      "name": "all-features",
      "hidden": true,
      "cacheVariables": {
        "QUARK_ENABLE_WARNING_EVERYTHING": "yes",
        "QUARK_ENABLE_TESTING": "yes"
      }
    },
    {
      "name": "debug",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "gcc-debug",
      "displayName": "gcc (Debug)",
      "inherits": [
        "base",
        "gcc",
        "debug"
      ]
    },
    {
      "name": "clang-debug",
      "displayName": "clang (Debug)",
      "inherits": [
        "base",
        "clang",
        "debug"
      ]
    },
    {
      "name": "clang-cl-debug",
      "displayName": "clang-cl (Debug)",
      "inherits": [
        "base",
        "clang-cl",
        "debug"
      ]
    },
    {
      "name": "w64-mingw32-gcc-debug",
      "displayName": "w64-mingw32-gcc (Debug)",
      "inherits": [
        "base",
        "w64-mingw32-gcc",
        "debug"
      ]
    },
    {
      "name": "clang-tidy-debug",
      "displayName": "clang-tidy (Debug)",
      "inherits": [
        "base",
        "clang",
        "clang-tidy",
        "debug",
        "all-features"
      ]
    },
    {
      "name": "gcc-release",
      "displayName": "gcc (Release)",
      "inherits": [
        "base",
        "gcc",
        "release"
      ]
    },
    {
      "name": "clang-release",
      "displayName": "clang (Release)",
      "inherits": [
        "base",
        "clang",
        "release"
      ]
    },
    {
      "name": "clang-cl-release",
      "displayName": "clang-cl (Release)",
      "inherits": [
        "base",
        "clang-cl",
        "release"
      ]
    },
    {
      "name": "clang-tidy-release",
      "displayName": "clang-tidy (Release)",
      "inherits": [
        "base",
        "clang",
        "clang-tidy",
        "release",
        "all-features"
      ]
    }
  ]
}
