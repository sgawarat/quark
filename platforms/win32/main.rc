#include "resource.h"

IDR_CONTEXT_MENU MENU
BEGIN
    POPUP "Context Menu"
    BEGIN
        MENUITEM "Enable/Disable", ID_ENABLE_DISABLE
        MENUITEM "Reset", ID_RESET
        MENUITEM "&Exit", ID_EXIT
    END
END

IDI_MYAPP ICON "assets/keyboard.ico"
IDI_KEYBOARD_ON ICON "assets/keyboard.ico"
IDI_KEYBOARD_OFF ICON "assets/keyboard-off.ico"
