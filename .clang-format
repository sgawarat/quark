# SPDX-License-Identifier: CC0-1.0

# clang-format 22
BasedOnStyle: Google
Language: Cpp
Standard: c++23

# 1行の長さを制限する
ColumnLimit: 100

# クラス内のアクセス修飾子のインデントを1つ下に合わせる
AccessModifierOffset: -2

# 括弧内を通常のインデントに合わせる
AlignAfterOpenBracket: false

# 行継続を示す\を整列させない
AlignEscapedNewlines: DontAlign

# 短いcaseラベルを1行にまとめる
AllowShortCaseLabelsOnASingleLine: true

# 空の関数のみを1行にする
AllowShortFunctionsOnASingleLine: Empty

# 波括弧初期化子のインデントを通常に戻す
BracedInitializerIndentWidth: 2

# 構造に意味のあるコメントをフォーマットしない
CommentPragmas: '\*|@|TODO|HACK|FIXME|BUG'

# コンストラクタ初期化子のインデントを通常に戻す
ConstructorInitializerIndentWidth: 2

# includeのまとまりの中でソートする
IncludeBlocks: Preserve

# ファイル終端に改行を加える
InsertNewlineAtEOF: true
---
