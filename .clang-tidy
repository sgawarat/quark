# SPDX-License-Identifier: CC0-1.0
---
Checks:
  - -*,

  - bugprone-*,
  - -bugprone-switch-missing-default-case, # switchにdefaultがなくても良い（コンパイラに任せるため）

  - cert-*,
  - -cert-dcl03-c, # 無理にassertをstatic_assertに直さなくても良い（実行時検査したい場合もあるため）

  - cppcoreguidelines-*,
  - -cppcoreguidelines-macro-usage, # マクロを使っても良い
  - -cppcoreguidelines-pro-type-vararg, # Cの可変長引数を使っても良い（ioctlとか）
  - -cppcoreguidelines-special-member-functions, # 暗黙的に定義されるコンストラクタを明示しなくても良い（mixinで表現するため）

  - clang-analyzer-*,

  - clang-diagnostic-*,

  - misc-*,
  - -misc-static-assert, # 無理にassertをstatic_assertに直さなくても良い（実行時検査したい場合もあるので）

  - modernize-*,
  - -modernize-use-trailing-return-type, # 戻り値の型を後置で宣言しなくても良い

  - performance-*,
  - -performance-enum-size, # enumのunderlying_type型を広く取っても良い

  - readability-*,
  - -readability-convert-member-functions-to-static, # 副作用のないメンバー関数をstaticにしなくても良い
  - -readability-named-parameter, # 実引数に名前がなくても良い
  - -readability-use-std-min-max, # 無理にmin/maxを使わなくて良い

CheckOptions:
  # マクロでdo whileを使っても良い
  - key: cppcoreguidelines-avoid-do-while.IgnoreMacros
    value: true

  # 暗黙的にインクルードされるヘッダは検査対象から除外する
  # 他、偽陽性をオフにする（signal.hとか）
  - key: misc-include-cleaner.IgnoreHeaders
    value: "config.h;signal.h;sigset_t.h"

  # ごく短い文は括弧で囲わなくても良い
  - key: readability-braces-around-statements.ShortStatementLines
    value: 1

  # Cognitive Complexityの計算にマクロの中身を含めない
  - key: readability-function-cognitive-complexity.IgnoreMacros
    value: true

  # よく使われる短縮名を許容する
  - key: readability-identifier-length.IgnoredVariableNames
    value: _|i|x|y|v|h|id|fn|os|fd
  - key: readability-identifier-length.IgnoredParameterNames
    value: _|i|x|y|v|h|id|fn|os|fd
  - key: readability-identifier-length.IgnoredLoopCounterNames
    value: i|x|y

  # ポインタの暗黙的なbool変換を許容する
  - key: readability-implicit-bool-conversion.AllowPointerConditions
    value: true
...
