# SPDX-License-Identifier: CC0-1.0
---
Checks:
  - -*,
  - bugprone-*,
  - cert-*,
  - cppcoreguidelines-*,
  - clang-analyzer-*,
  - clang-diagnostic-*,
  - misc-*,
  - modernize-*,
  - performance-*,
  - readability-*,

  # switchにdefaultがなくても良い。
  - -bugprone-switch-missing-default-case,

  # マクロを使っても良い。
  - -cppcoreguidelines-macro-usage,

  # 暗黙的に定義されるコンストラクタを明示しなくても良い。
  - -cppcoreguidelines-special-member-functions,

  # 戻り値の型を後置で宣言しなくても良い。
  - -modernize-use-trailing-return-type,

  # enumのunderlying_type型を広く取っても良い。
  - -performance-enum-size,

  # 実引数に名前がなくても良い。
  - -readability-named-parameter,

  # 副作用のないメンバー関数をstaticにしなくても良い。
  - -readability-convert-member-functions-to-static,

CheckOptions:
  # マクロでdo whileを使っても良い。
  - key: cppcoreguidelines-avoid-do-while.IgnoreMacros
    value: true

  # 型エイリアスにマジックナンバーが含まれていても良い。
  - key: cppcoreguidelines-avoid-magic-numbers.IgnoreTypeAliases
    value: true
  - key: readability-magic-numbers.IgnoreTypeAliases
    value: true

  # 間接的にincludeされるシンボルを使っても良い
  - key: misc-include-cleaner.MissingIncludes
    value: false

  # ごく短い文は括弧で囲わなくても良い。
  - key: readability-braces-around-statements.ShortStatementLines
    value: 1

  # よく使われる短縮名を許容する。
  - key: readability-identifier-length.IgnoredVariableNames
    value: _|i|x|y|r|v|h|id|fn|os
  - key: readability-identifier-length.IgnoredParameterNames
    value: _|i|x|y|v|h|id|fn|os
  - key: readability-identifier-length.IgnoredLoopCounterNames
    value: i|x|y

  # ポインタの暗黙的なbool変換を許容する。
  - key: readability-implicit-bool-conversion.AllowPointerConditions
    value: true
...
