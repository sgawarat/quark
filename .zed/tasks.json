[
  {
    "label": "Configure",
    "command": "cmake",
    "args": ["--preset", "default", "--fresh"],
    "save": "all",
  },
  {
    "label": "Configure lint",
    "command": "cmake",
    "args": ["--preset", "lint", "--fresh"],
    "save": "all",
  },
  {
    "label": "Build all",
    "command": "cmake",
    "args": ["--workflow", "--preset", "build"],
    "save": "all",
    "env": { "CMAKE_BUILD_TARGET": "all" },
  },
  {
    "label": "Rebuild all",
    "command": "cmake",
    "args": ["--workflow", "--preset", "rebuild"],
    "save": "all",
    "env": { "CMAKE_BUILD_TARGET": "all" },
  },
  {
    "label": "Build quark",
    "command": "cmake",
    "args": ["--workflow", "--preset", "build"],
    "save": "all",
    "env": { "CMAKE_BUILD_TARGET": "quark" },
  },
  {
    "label": "Rebuild quark-qt",
    "command": "cmake",
    "args": ["--workflow", "--preset", "rebuild"],
    "save": "all",
    "env": { "CMAKE_BUILD_TARGET": "quark-qt" },
  },
  {
    "label": "Build quark-qt",
    "command": "cmake",
    "args": ["--workflow", "--preset", "build"],
    "save": "all",
    "env": { "CMAKE_BUILD_TARGET": "quark-qt" },
  },
  {
    "label": "Rebuild quark",
    "command": "cmake",
    "args": ["--workflow", "--preset", "rebuild"],
    "save": "all",
    "env": { "CMAKE_BUILD_TARGET": "quark" },
  },
  {
    "label": "Build tests",
    "command": "cmake",
    "args": ["--workflow", "--preset", "build"],
    "save": "all",
    "env": { "CMAKE_BUILD_TARGET": "tests" },
  },
  {
    "label": "Rebuild tests",
    "command": "cmake",
    "args": ["--workflow", "--preset", "rebuild"],
    "save": "all",
    "env": { "CMAKE_BUILD_TARGET": "tests" },
  },
  {
    "label": "Release",
    "command": "cmake",
    "args": ["--workflow", "--preset", "rebuild", "--fresh"],
    "save": "all",
    "env": {
      "CMAKE_BUILD_TYPE": "Release",
      "CMAKE_BUILD_TARGET": "all",
      "QUARK_ENABLE_DEBUGGING_WORKAROUNDS": "no",
    },
  },
]
