{
  "languages": {
    "C": {
      "tab_size": 2,
    },
    "C++": {
      "tab_size": 2,
    },
    "CMake": {
      "tab_size": 2,
      "preferred_line_length": 120,
    },
  },
  "lsp": {
    "clangd": {
      "binary": {
        "path": "clangd",
      },
    },
  },
  "terminal": {
    "env": {
      "QMK_FIRMWARE_DIR": "../qmk_firmware",
      "QUARK_KEYBOARD": "jis",
      "QUARK_KEYMAP": "example",
      "QUARK_ENABLE_TESTING": "yes",
    },
  },
}
